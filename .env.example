# LLM API 配置（OpenAI 兼容接口）
# 默认使用 DeepSeek，修改 BASE_URL 和 MODEL 即可切换模型

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# 可选配置
# LLM_MODEL=qwen-plus       # 通义千问
# LLM_MODEL=gpt-4o-mini     # OpenAI
# LLM_TEMPERATURE=0.7       # 生成温度，默认 0.7
# LLM_MAX_TOKENS=2048       # 最大输出 token 数

# 视觉模型配置（用于商品图片分析）
# 默认使用 Qwen-VL-Max，通过阿里云 DashScope 兼容端点
VISION_API_KEY=your_vision_api_key_here              # 默认复用 LLM_API_KEY
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
